+    ),
+    createProfessorProfileSection(professor, "취미", "Hobbies"),
+  ].filter(Boolean).forEach((section) => moreBody.append(section));
+  more.append(summary, moreBody);
+
+  profile.append(photo, main, more);
+  container.replaceChildren(profile);
+}
