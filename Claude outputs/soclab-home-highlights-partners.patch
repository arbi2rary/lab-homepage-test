+/* ------------------------------------------------------------
+   최근 소식 — 히어로 아래 요약 보드
+   ------------------------------------------------------------ */
+.news-highlights{padding:clamp(48px,6vw,72px) 0 clamp(40px,5vw,60px)}
+.news-highlights .wrap{
+  display:grid;
+  grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(240px,.72fr);
+  gap:clamp(28px,3.5vw,48px);
+  align-items:start;
+}
+.highlight-head{
+  display:flex;
+  align-items:baseline;
+  justify-content:space-between;
+  gap:14px;
+  padding-bottom:12px;
+  border-bottom:2px solid var(--copper);
+}
+.highlight-head h2{font-size:19px;font-weight:600;color:var(--copper);margin:0}
+.highlight-more{
+  flex:none;
+  font-size:13px;
+  color:var(--ink-soft);
+  text-decoration:none;
+  border-bottom:1px solid transparent;
+}
+.highlight-more::after{content:" \2192"}
+.highlight-more:hover{color:var(--copper);border-bottom-color:var(--copper)}
+.highlight-list{list-style:none;margin:0;padding:0}
+.highlight-list li + li{border-top:1px solid var(--line)}
+.highlight-item{
+  display:flex;
+  align-items:baseline;
+  justify-content:space-between;
+  gap:18px;
+  padding:14px 2px;
+  color:var(--ink);
+  text-decoration:none;
+}
+.highlight-item-title{
+  font-size:15px;
+  line-height:1.55;
+  word-break:keep-all;
+  overflow-wrap:anywhere;
+}
+.highlight-item-date{
+  flex:none;
+  font-size:12.5px;
+  color:var(--ink-soft);
+  font-family:"IBM Plex Mono",monospace;
+}
+.highlight-item:hover .highlight-item-title{color:var(--copper);text-decoration:underline}
+.highlight-empty{padding:14px 2px;font-size:14px;color:var(--ink-soft)}
+.highlight-cta{
+  padding:26px 26px 28px;
+  border:1px solid var(--line);
+  border-radius:10px;
+  background:var(--bg-soft);
+}
+.highlight-cta h2{font-size:18px;font-weight:600;margin:6px 0 10px;line-height:1.45}
+.highlight-cta p{font-size:14px;color:var(--ink-soft);line-height:1.7;margin-bottom:18px}
+.highlight-cta .btn{width:100%;justify-content:center}
+
+@media (max-width:980px){
+  .news-highlights .wrap{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
+  .highlight-cta{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:6px 32px}
+  .highlight-cta .eyebrow{grid-column:1}
+  .highlight-cta h2{grid-column:1;margin:0}
+  .highlight-cta p{grid-column:1;margin:0}
+  .highlight-cta .btn{grid-column:2;grid-row:1/-1;width:auto}
+}
+
+@media (max-width:760px){
+  .news-highlights .wrap{grid-template-columns:1fr}
+  .highlight-cta{grid-template-columns:1fr}
+  .highlight-cta .btn{grid-column:1;grid-row:auto;width:100%;margin-top:16px}
+}
+
+/* ------------------------------------------------------------
+   소속 및 협력 기관 로고
+   ------------------------------------------------------------ */
+.partners{padding:0 0 clamp(34px,4vw,52px)}
+.partners .wrap{padding-top:clamp(28px,3.5vw,40px);border-top:1px solid var(--line)}
+.partner-list{
+  list-style:none;
+  margin:0;
+  padding:0;
+  display:flex;
+  flex-wrap:wrap;
+  align-items:center;
+  justify-content:center;
+  gap:clamp(28px,5vw,64px);
+}
+.partner-logo{
+  display:flex;
+  align-items:center;
+  justify-content:center;
+  height:56px;
+  filter:grayscale(1);
+  opacity:.62;
+  transition:filter .2s ease,opacity .2s ease;
+}
+.partner-logo-tall{height:88px}
+.partner-logo img{max-width:220px;max-height:100%;width:auto;height:auto}
+a.partner-logo:hover,
+a.partner-logo:focus-visible{filter:none;opacity:1}
+
+@media (max-width:760px){
+  .partner-list{gap:26px 32px}
+  .partner-logo{height:46px}
+  .partner-logo-tall{height:68px}
+  .partner-logo img{max-width:170px}
+}
+
